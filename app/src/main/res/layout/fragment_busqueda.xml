<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshBusqueda"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101322"
    tools:context=".parteVisual.fragments.principalFragments.BusquedaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101322"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvTituloBusqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:letterSpacing="0.08"
            android:text="FAVORITOS PÚBLICOS"
            android:textAllCaps="true"
            android:textColor="#9AA3B2"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutControlesBusqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_busqueda_input">

                <ImageView
                    android:id="@+id/ivIconoBuscarBusqueda"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search"
                    app:tint="#8E9193" />

                <EditText
                    android:id="@+id/etBuscadorBusqueda"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@android:color/transparent"
                    android:hint="Buscar canción..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#E3E0F2"
                    android:textColorHint="#8E9193"
                    android:textSize="16sp" />

            </FrameLayout>

            <ImageButton
                android:id="@+id/btnRecargarBusqueda"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_busqueda_boton"
                android:contentDescription="Recargar canciones públicas"
                android:padding="16dp"
                android:src="@drawable/ic_refresh"
                app:tint="#E3E0F2" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerBusqueda"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="24dp"
                tools:listitem="@layout/viewholder_busqueda_cancion" />

            <TextView
                android:id="@+id/tvMensajeBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="inicia sesión para poder ver la lista de canciones favoritas públicas"
                android:textColor="#E3E0F2"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>