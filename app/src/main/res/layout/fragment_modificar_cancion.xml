<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111425"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="24dp"
    android:paddingTop="22dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp"
    tools:context=".parteVisual.fragments.internalFragments.otherFragments.ModificarCancionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloModificarCancion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modificar canción"
            android:textColor="#E3E0F2"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloModificarCancion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Edita los datos visibles de la canción."
            android:textColor="#99C8C5CC"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1F1E2B"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#33444749"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    app:cardBackgroundColor="#0D0D19"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#22FFFFFF"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivImagenEditar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/imagenotfound" />

                        <TextView
                            android:id="@+id/btnCambiarImagen"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="14dp"
                            android:background="@drawable/bg_busqueda_boton"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:text="Cambiar carátula"
                            android:textAllCaps="false"
                            android:textColor="#E3E0F2"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#1F1E2B"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#33444749"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutNombreCancion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre"
                    app:boxBackgroundColor="#292936"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="#C6C6C7"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:hintTextColor="#C4C7C9">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreCancion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="textCapSentences"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="#E3E0F2"
                        android:textColorHint="#8E9193"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutArtistaCancion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="Artista"
                    app:boxBackgroundColor="#292936"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="#C6C6C7"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:hintTextColor="#C4C7C9">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etArtistaCancion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="textCapWords"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="#E3E0F2"
                        android:textColorHint="#8E9193"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutAlbumCancion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="Álbum"
                    app:boxBackgroundColor="#292936"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="#C6C6C7"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:hintTextColor="#C4C7C9">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAlbumCancion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:inputType="textCapWords"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="#E3E0F2"
                        android:textColorHint="#8E9193"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvRutaLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:letterSpacing="0.08"
                    android:text="RUTA DEL ARCHIVO"
                    android:textAllCaps="true"
                    android:textColor="#7FA1FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRutaCancion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#292936"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    android:padding="14dp"
                    android:textColor="#99C8C5CC"
                    android:textSize="12sp"
                    tools:text="/storage/emulated/0/Music/cancion.mp3" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvAvisoModificar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Al guardar, más adelante la app creará una nueva canción con estos datos y sustituirá la original."
            android:textColor="#7FA1FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarCambios"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textColor="#111425"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#E3E2E3"
            app:cornerRadius="28dp" />

    </LinearLayout>

</ScrollView>