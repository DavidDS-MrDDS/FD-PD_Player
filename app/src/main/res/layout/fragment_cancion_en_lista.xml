<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101322"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="22dp"
    android:paddingEnd="28dp"
    android:paddingBottom="22dp"
    tools:context=".fragments.internalFragments.itemFragments.CancionEnListaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvEtiquetaLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REPRODUCIENDO LISTA"
            android:textColor="#7FA1FF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvSubEtiquetaLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Solo se reproducen canciones de esta lista"
            android:textColor="#99C8C5CC"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1F1E2B"
            app:cardCornerRadius="28dp"
            app:cardElevation="14dp"
            app:strokeColor="#227FA1FF"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="#0D0D19"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivCaratula"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/imagenotfound" />

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNombreCancion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nombre de la canción"
            android:textColor="#E3E0F2"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubCancion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Álbum • Artista"
            android:textColor="#99C8C5CC"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBarProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#26FFFFFF"
            android:progressTint="#7FA1FF"
            android:splitTrack="false"
            android:thumbTint="#E3E0F2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTiempoActual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="0:00"
                android:textColor="#99C8C5CC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTiempoFinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="--:--"
                android:textColor="#99C8C5CC"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnAnterior"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginEnd="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="Canción anterior"
                android:padding="10dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#E3E0F2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayPause"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:gravity="center"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text=""
                app:backgroundTint="#E3E0F2"
                app:cornerRadius="34dp"
                app:elevation="8dp"
                app:icon="@drawable/ic_player_play"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="34dp"
                app:iconTint="#101322" />

            <ImageButton
                android:id="@+id/btnSiguiente"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginStart="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="Siguiente canción"
                android:padding="10dp"
                android:src="@android:drawable/ic_media_next"
                app:tint="#E3E0F2" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnConfigurar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Configurar canción"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="#CCC8C5CC" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnModoReproduccion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Modo de reproducción"
            android:padding="11dp"
            android:src="@drawable/ic_repeat"
            app:tint="#CCC8C5CC" />

    </LinearLayout>

</LinearLayout>