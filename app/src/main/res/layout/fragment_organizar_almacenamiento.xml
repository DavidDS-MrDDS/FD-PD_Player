<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111425"
    tools:context=".fragments.internalFragments.settingFragments.OrganizarAlmacenamientoFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#1F1E2B"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#33444749"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_ajustes_icon_box">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:contentDescription="Organizar almacenamiento"
                            android:src="@drawable/ic_folder"
                            app:tint="#CBD5E1" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTituloOrganizar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Organizar almacenamiento"
                        android:textColor="#E3E0F2"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEstadoOrganizacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="La carpeta todavía no se ha organizado."
                        android:textColor="#C4C7C9"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDescripcionOrganizacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="La aplicación creará la carpeta FD-PD_Player_Canciones y preparará allí las canciones visibles de Canciones."
                        android:textColor="#99C8C5CC"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Las canciones ocultas se ignorarán.\nLos favoritos no se modificarán."
                        android:textColor="#7FA1FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOrganizarCanciones"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="30dp"
                        android:text="Organizar canciones"
                        android:textColor="#111425"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="#E3E2E3"
                        app:cornerRadius="28dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</FrameLayout>