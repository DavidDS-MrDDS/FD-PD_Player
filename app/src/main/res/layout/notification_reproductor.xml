<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutNotifRoot"
    android:layout_width="match_parent"
    android:layout_height="156dp"
    android:background="@drawable/bg_notificacion_reproductor"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivNotifImagen"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@drawable/imagenotfound" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNotifNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nombre de la canción"
                android:textColor="#E3E0F2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotifArtista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Artista"
                android:textColor="#99C8C5CC"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnNotifAnterior"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_notificacion_boton"
            android:contentDescription="Anterior"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#E3E0F2" />

        <ImageButton
            android:id="@+id/btnNotifPlayPause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_notificacion_boton"
            android:contentDescription="Reproducir o pausar"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_player_play"
            android:tint="#E3E0F2" />

        <ImageButton
            android:id="@+id/btnNotifSiguiente"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_notificacion_boton"
            android:contentDescription="Siguiente"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_media_next"
            android:tint="#E3E0F2" />

        <ImageButton
            android:id="@+id/btnNotifCerrar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_notificacion_boton"
            android:contentDescription="Detener"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFB4AB" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNotifTiempoActual"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:text="0:00"
            android:textColor="#99C8C5CC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressNotifCancion"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#26FFFFFF"
            android:progressTint="#E3E0F2" />

        <TextView
            android:id="@+id/tvNotifTiempoFinal"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:text="--:--"
            android:textColor="#99C8C5CC"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>