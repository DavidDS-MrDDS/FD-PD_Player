<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/principalFragment">

    <!-- Principal -->
    <fragment
        android:id="@+id/principalFragment"
        android:name="es.iesagora.fd_pdplayer.fragments.PrincipalFragment"
        android:label="FD-PD Player"
        tools:layout="@layout/fragment_principal" />

    <!-- Listas y favoritos -->
    <fragment
        android:id="@+id/favoritosFragment"
        android:name="es.iesagora.fd_pdplayer.fragments.internalFragments.listFragments.FavoritosFragment"
        android:label="Favoritos"
        tools:layout="@layout/fragment_favoritos" />

    <fragment
        android:id="@+id/listaFragment"
        android:name="es.iesagora.fd_pdplayer.fragments.internalFragments.listFragments.ListaFragment"
        android:label="Lista"
        tools:layout="@layout/fragment_lista">

        <argument
            android:name="listaId"
            app:argType="integer" />

        <action
            android:id="@+id/action_listaFragment_to_cancionEnListaFragment"
            app:destination="@id/cancionEnListaFragment" />

    </fragment>

    <!-- Reproductores -->
    <fragment
        android:id="@+id/cancionFragment"
        android:name="es.iesagora.fd_pdplayer.fragments.internalFragments.itemFragments.CancionFragment"
        android:label="Canción"
        tools:layout="@layout/fragment_cancion">

        <argument
            android:name="cancion"
            app:argType="es.iesagora.fd_pdplayer.funcionamiento.models.Cancion" />

        <argument
            android:name="posicion"
            app:argType="integer" />

    </fragment>

    <fragment
        android:id="@+id/cancionEnListaFragment"
        android:name="es.iesagora.fd_pdplayer.fragments.internalFragments.itemFragments.CancionEnListaFragment"
        android:label="Canción en lista"
        tools:layout="@layout/fragment_cancion_en_lista">

        <argument
            android:name="cancion"
            app:argType="es.iesagora.fd_pdplayer.funcionamiento.models.Cancion" />

        <argument
            android:name="posicion"
            app:argType="integer" />

    </fragment>

    <!-- Ajustes -->
    <fragment
        android:id="@+id/cancionesOcultasFragment"
        android:name="es.iesagora.fd_pdplayer.fragments.internalFragments.settingFragments.CancionesOcultasFragment"
        android:label="Canciones ocultas"
        tools:layout="@layout/fragment_canciones_ocultas" />

    <fragment
        android:id="@+id/organizarAlmacenamientoFragment"
        android:name="es.iesagora.fd_pdplayer.fragments.internalFragments.settingFragments.OrganizarAlmacenamientoFragment"
        android:label="Organizar almacenamiento"
        tools:layout="@layout/fragment_organizar_almacenamiento" />

    <fragment
        android:id="@+id/contactoFragment"
        android:name="es.iesagora.fd_pdplayer.fragments.internalFragments.settingFragments.ContactoFragment"
        android:label="Contacto"
        tools:layout="@layout/fragment_contacto" />

    <!-- Otros -->
    <fragment
        android:id="@+id/modificarCancionFragment"
        android:name="es.iesagora.fd_pdplayer.fragments.internalFragments.otherFragments.ModificarCancionFragment"
        android:label="Modificar canción"
        tools:layout="@layout/fragment_modificar_cancion">

        <argument
            android:name="cancion"
            app:argType="es.iesagora.fd_pdplayer.funcionamiento.models.Cancion" />

    </fragment>

</navigation>